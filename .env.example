# Copiar a .env y completar. NUNCA commitear .env
# Generar wallets de auditores con: cast wallet new   (x3)

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Deployer = owner del proyecto (necesita Sepolia ETH, ~0.03 alcanza)
PRIVATE_KEY=0x

# Direcciones públicas de los auditores registradas al desplegar.
AUDITOR_1=0x
AUDITOR_2=0x
AUDITOR_3=0x

# Claves privadas correspondientes a los auditores 1 y 2 para ejecutar Interact.
# No se usan para desplegar; no necesitan fondos iniciales, Interact les envía gas.
AUDITOR_1_PK=0x
AUDITOR_2_PK=0x

# Se completa después del deploy
FUND_ADDRESS=0x

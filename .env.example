# Copiar a .env y completar. NUNCA commitear .env
# Generar wallets de auditores con: cast wallet new   (x3)

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Deployer = owner del proyecto (necesita Sepolia ETH, ~0.03 alcanza)
PRIVATE_KEY=0x

# Auditores (no necesitan fondos: el script Interact les manda gas)
AUDITOR_1_PK=0x
AUDITOR_2_PK=0x
AUDITOR_3_PK=0x

# Se completa después del deploy
FUND_ADDRESS=0x
